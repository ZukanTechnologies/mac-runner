<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ephemeral mobile-runner agent — launchd template (ZUK-2155).

  Rendered by the mac-runner installer, one copy per VM slot ({{SLOT}} = 1..2;
  Apple's Virtualization framework allows max 2 concurrent VMs per host).
  Placeholders: {{SLOT}} {{BASE_IMAGE}} {{EXTRA_LABELS}} {{LOG_PATH}}.
  Substituted values sit inside XML <string> elements — the renderer must
  reject values containing & < > (the installer's render helper enforces
  this; ZUK-2158).
  Manual use: replace every placeholder, save as
  ~/Library/LaunchAgents/com.zukan.mobile-runner-agent.slot<N>.plist, then
  `launchctl bootstrap gui/$(id -u) <path>`.

  CONTAINS NO CREDENTIAL (FR-009/FR-010): the agent op-reads the JIT PAT
  from 1Password every cycle using the service-account token file
  (~/.config/zukan-runner/op-token, written 0600 by the installer).
  Never add ZUKAN_GH_PAT here — it is a local-debug env override only.

  IMPORTANT — run as a LaunchAgent in a logged-in GUI session, NOT a system
  LaunchDaemon. macOS 15+/Tahoe requires an unlocked login.keychain to boot a
  Tart VM (an undocumented Virtualization.framework requirement), and that
  keychain only exists inside a logged-in user session. So the host needs
  auto-login for the CI user and `sudo pmset -a sleep 0 disksleep 0`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zukan.mobile-runner-agent.slot{{SLOT}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/zukan/mobile-runner-agent.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SLOT</key>
    <string>{{SLOT}}</string>
    <key>BASE_IMAGE</key>
    <string>{{BASE_IMAGE}}</string>
    <key>RUNNER_EXTRA_LABELS</key>
    <string>{{EXTRA_LABELS}}</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A LaunchAgent runs as the CI user (not root), so it cannot write
       /var/log. {{LOG_PATH}} defaults to /tmp/zukan-mobile-runner-agent.slotN.log
       (point at ~/Library/Logs/ for persistence across reboots). -->
  <key>StandardOutPath</key>
  <string>{{LOG_PATH}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_PATH}}</string>
</dict>
</plist>
